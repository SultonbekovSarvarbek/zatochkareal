# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Admin Group Chat ID
# This is the Telegram group where order notifications will be sent
# To get your group chat ID, add @RawDataBot to your group
GROUP_CHAT_ID=your_group_chat_id_here

# Admin User IDs (Optional)
# Comma-separated list of Telegram user IDs who can use admin commands (/find, /orders)
# If not specified, all members of the group can use admin commands
# Example: ADMIN_USER_IDS=123456789,987654321
ADMIN_USER_IDS=
